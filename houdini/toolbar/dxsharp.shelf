<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="dxsharp_studio_shelf" label="DXSharp">
    <memberTool name="dxsharp_studio_start"/>
    <memberTool name="dxsharp_studio_stop"/>
  </toolshelf>
  <tool name="dxsharp_studio_start" label="Start Studio Bridge" icon="BUTTONS_play">
    <script scriptType="python"><![CDATA[
import dxsharp_studio
dxsharp_studio.start()
]]></script>
  </tool>
  <tool name="dxsharp_studio_stop" label="Stop Studio Bridge" icon="BUTTONS_stop">
    <script scriptType="python"><![CDATA[
import dxsharp_studio
dxsharp_studio.stop()
]]></script>
  </tool>
</shelfDocument>
